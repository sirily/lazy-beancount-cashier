HOST_BEANCOUNT_WORKSPACE=/tmp/cashier-beancount-workspace
# Stage 2 writeback appends to this file inside HOST_BEANCOUNT_WORKSPACE.
# Create it before deploy and ensure the container runtime user can write it
# (cashier-server-python image currently runs as uid/gid 999:999).
HOST_BEANCOUNT_MANUAL_TRANSACTIONS_FILE=/tmp/cashier-beancount-workspace/manual_transactions.bean

# Example: use specific image tag SHA for reproducibility
PWA_VERSION=sha-abcdef1234567890
SERVER_VERSION=sha-123456abcdef7890
CASHIER_HTTP_BIND=127.0.0.1:8080

# Optional comma-separated CORS origins for development.
CASHIER_CORS_ORIGINS=
