# Public host routed by Pangolin / Traefik to cashier-caddy.
CASHIER_HOST=cashier.example.com

# External Docker network used by Traefik/Pangolin.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure

# Prebuilt images from the application repositories.
CASHIER_PWA_IMAGE=ghcr.io/sirily/cashier-sveltekit:latest
CASHIER_SERVER_IMAGE=ghcr.io/sirily/cashier-server-python:latest

# Host path containing the full Lazy Beancount book.
# This is mounted read-only at /workspace in cashier-server.
LAZYBEAN_PATH=/absolute/path/to/lazybean
BEANCOUNT_FILE=/workspace/main.bean

# Stage 1 is read-only sync. Keep shutdown disabled in production.
CASHIER_ENABLE_SHUTDOWN=false

# Optional comma-separated CORS origins for development.
# Production should normally be same-origin via https://$CASHIER_HOST/api.
CASHIER_CORS_ORIGINS=
